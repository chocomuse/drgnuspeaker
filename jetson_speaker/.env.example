DRGNU_BASE_URL=https://aidrgnu.com/
DRGNU_API_KEY=replace-with-server-api-key
DRGNU_DEVICE_ID=jetson-nano-dev-001
DRGNU_DEVICE_NAME=Drgnu Jetson Speaker
DRGNU_DEVICE_TOKEN=
DRGNU_DEVICE_TOKEN_PATH=.device-token
DRGNU_PAIRING_ENABLED=false
DRGNU_PAIRING_POLL_SECONDS=3
DRGNU_LOCAL_PAIRING_ENABLED=true
DRGNU_LOCAL_PAIRING_PORT=8765
DRGNU_LOCAL_PAIRING_SERVICE_TYPE=_drgnu-speaker._tcp.local.
DRGNU_SETTINGS_SYNC_ENABLED=true
DRGNU_SETTINGS_SYNC_SECONDS=30
DRGNU_SESSION_ID=test_user_001
DRGNU_WAKE_MODE=keyboard
DRGNU_WAKE_MODEL_PATH=models/vosk-model-small-ko-0.22
DRGNU_WAKE_TIMEOUT_SECONDS=0
DRGNU_WAKE_STT_SECONDS=2.0
DRGNU_WAKE_STT_PAUSE_SECONDS=0.2
DRGNU_RECORD_SECONDS=7
DRGNU_SAMPLE_RATE=16000
DRGNU_CHANNELS=1
DRGNU_GOOGLE_STT_ENABLED=true
DRGNU_GOOGLE_STT_LANGUAGE_CODE=ko-KR
# Either set a direct Google Cloud Speech-to-Text API key:
DRGNU_GOOGLE_STT_API_KEY=
# Or point to a Firebase/Android google-services.json that contains client[0].api_key[0].current_key:
DRGNU_GOOGLE_SERVICES_JSON=google-services.json
# Recommended for Jetson/Windows: point to a Google Cloud service account JSON:
DRGNU_GOOGLE_SERVICE_ACCOUNT_JSON=
# For basic robot voice: spd-say
# For natural google voice (requires 'pip install gTTS' and 'apt install mpg123'): python scripts/gtts_speak.py
DRGNU_TTS_COMMAND=python scripts/gtts_speak.py
DRGNU_PTT_GPIO_PIN=
DRGNU_LED_GPIO_PIN=
